# Optional. Preferred JSON-RPC URL per chain. Public fallbacks are used when unset.
# Public EVM endpoints rate-limit `eth_getLogs` (and sometimes burst `eth_call`).
# Treat a truncated log window as incomplete — never as "no approvals".
RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=

# Optional. Preferred Solana mainnet JSON-RPC.
# Public fallbacks (PublicNode, api.mainnet-beta.solana.com, Ankr, 1rpc, drpc)
# are used when unset. They rate-limit `getTokenAccountsByOwner`.
# App works with plain JSON-RPC alone — no enhanced indexer required.
SOLANA_RPC=

# Optional. If set, used as a Helius JSON-RPC URL
# (https://mainnet.helius-rpc.com/?api-key=…) after SOLANA_RPC.
# Same getTokenAccountsByOwner methods — not a separate data model.
# HELIUS_API_KEY=

# Optional. One Etherscan API v2 key covers Ethereum, Base, and Arbitrum One.
# Blast Radius calls https://api.etherscan.io/v2/api and passes `chainid`
# (1 / 8453 / 42161). Do not set a separate Basescan or Arbiscan key.
# https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Optional. Public origin used in share links / OG (no trailing slash).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=
