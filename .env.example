# Optional. Dedicated Ethereum JSON-RPC URL (mainnet).
# Public fallbacks are used when this is unset.
RPC_URL=

# Optional. Etherscan API v2 key — improves Approval-log discovery
# beyond public RPC block-range limits.
# https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Optional. Public origin used in share links / OG (no trailing slash).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=
